/-
Generated by proofs/generate.py from the atlas code; do not edit by hand.

Laurent polynomial identities over GF(2), stated in any commutative ring of
characteristic 2 for x, x⁻¹ = xi, y, y⁻¹ = yi. Each proof is a certificate that
Lean's `ring` rechecks.
-/
import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Tactic.LinearCombination

-- Some polynomials do not use every one of x, xi, y, yi.
set_option linter.unusedVariables false

namespace LatticeProofs

variable {R : Type*} [CommRing R]

/-- The hexagon's parity rule H1 (B135/S135): the six nearest cells, axial coordinates. -/
def hexH1 (x xi y yi : R) : R :=
  xi + xi*y + yi + y + x*yi + x

/-- The square's four nearest cells (the sigma automaton). -/
def sqN4 (x xi y yi : R) : R :=
  xi + yi + y + x

/-- The square's four nearest cells and the cell itself (the sigma-plus automaton). -/
def sqN4self (x xi y yi : R) : R :=
  xi + yi + 1 + y + x

/-- The square's four diagonal cells. -/
def sqD4 (x xi y yi : R) : R :=
  xi*yi + xi*y + x*yi + x*y

/-- The square's eight cells at distance sqrt 5 (knight moves). -/
def sqK8 (x xi y yi : R) : R :=
  yi*xi^2 + y*xi^2 + xi*yi^2 + xi*y^2 + x*yi^2 + x*y^2 + yi*x^2 + y*x^2

/-- The square's nine-cell parity rule with the cell itself (B1357/S02468). -/
def sqN4D4self (x xi y yi : R) : R :=
  xi*yi + xi + xi*y + yi + 1 + y + x*yi + x + x*y

/-- The square rule D4 + A4 + self. -/
def sqD4A4self (x xi y yi : R) : R :=
  xi^2 + xi*yi + xi*y + yi^2 + 1 + y^2 + x*yi + x*y + x^2

/-- The square rule N4 + K8 + C4 (round 2). -/
def sqN4K8C4 (x xi y yi : R) : R :=
  xi^3 + yi*xi^2 + y*xi^2 + xi*yi^2 + xi + xi*y^2 + yi^3 + yi + y + y^3 + x*yi^2 + x + x*y^2 + yi*x^2 + y*x^2 + x^3

/-- The square rule A4 + K8 + C4 + self (round 2's first failure). -/
def sqA4K8C4self (x xi y yi : R) : R :=
  xi^3 + yi*xi^2 + xi^2 + y*xi^2 + xi*yi^2 + xi*y^2 + yi^3 + yi^2 + 1 + y^2 + y^3 + x*yi^2 + x*y^2 + yi*x^2 + x^2 + y*x^2 + x^3

/-- The square rule C4 + self (round 2). -/
def sqC4self (x xi y yi : R) : R :=
  xi^3 + yi^3 + 1 + y^3 + x^3

/-- The square rule A4 + C4 (round 2's accident at n = 13). -/
def sqA4C4 (x xi y yi : R) : R :=
  xi^3 + xi^2 + yi^3 + yi^2 + y^2 + y^3 + x^2 + x^3

/-- The triangle rule E's up-from-down entry (its matrix is [[0, ud], [du, 0]]). -/
def triUdE (x xi y yi : R) : R :=
  1 + y + x*y

/-- The triangle rule E's down-from-up entry. -/
def triDuE (x xi y yi : R) : R :=
  xi*yi + yi + 1

/-- The triangle rule VO + T13's up-from-down entry (no same-orientation part). -/
def triUdVOT13 (x xi y yi : R) : R :=
  yi*xi^2 + xi^2 + xi + x*yi + x + x*y^2 + x*y^3 + x^2 + x^2*y^3

/-- The triangle rule VO + T13's down-from-up entry. -/
def triDuVOT13 (x xi y yi : R) : R :=
  xi^2*yi^3 + xi^2 + xi*yi^3 + xi*yi^2 + xi + xi*y + x + x^2 + y*x^2

/-- The triangle shell VS, same orientation: a scalar on the translation lattice. -/
def triVS (x xi y yi : R) : R :=
  xi*yi + xi + yi + y + x + x*y

/-- The edge rule's s, where its matrix squares to s I. -/
def triSE (x xi y yi : R) : R :=
  xi*yi + xi + yi + 1 + y + x + x*y

/-- VO + T13's s, where its matrix squares to s I. -/
def triSVOT13 (x xi y yi : R) : R :=
  xi^4*yi^4 + xi^4*yi^3 + yi*xi^4 + xi^4 + xi^3*yi^4 + xi^3*yi^3 + xi^3*yi^2 + yi*xi^3 + xi^3 + y*xi^3 + xi^2*yi^3 + xi^2*yi^2 + xi^2 + y*xi^2 + xi*yi^4 + xi*yi^3 + xi*yi + xi + xi*y^2 + xi*y^3 + yi^4 + yi^3 + yi^2 + yi + 1 + y + y^2 + y^3 + y^4 + x*yi^3 + x*yi^2 + x + x*y + x*y^3 + x*y^4 + yi*x^2 + x^2 + x^2*y^2 + x^2*y^3 + yi*x^3 + x^3 + y*x^3 + x^3*y^2 + x^3*y^3 + x^3*y^4 + x^4 + y*x^4 + x^4*y^3 + x^4*y^4

/-- Two steps of the hexagon's parity rule are three passes of rule 90, one along each lattice direction: H1^2 = (x + 1/x)(y + 1/y)(x/y + y/x). This is the identity behind the hexagon theorem (docs/parity-lattices.md). -/
theorem hexagon_two_steps (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (hexH1 x xi y yi)^2 =
      (x + xi)*(y + yi)*(x*yi + xi*y) := by
  unfold hexH1
  linear_combination (2 - y^2 - yi^2 + 2*y + 2*yi) * hx + (2 - x^2 - xi^2 + 2*x + 2*xi) * hy + (2 + x + xi + y + yi + x*y + x*yi + x*yi^2 + xi*y + xi*yi + xi*y^2 + y*xi^2 + yi*x^2) * h2

/-- H1 splits into three passes of rule 60: H1 = (1 + x)(1 + y)(1 + x/y) / x. -/
theorem hexagon_split (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (hexH1 x xi y yi) =
      xi*(1 + x)*(1 + y)*(1 + x*yi) := by
  unfold hexH1
  linear_combination (-1 - y - yi - x*yi - y*yi - x*y*yi) * hx + (-1 - x) * hy + (-1) * h2

/-- D4 is rule 90 along each axis: D4 = (x + 1/x)(y + 1/y). -/
theorem square_D4_tensor (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqD4 x xi y yi) =
      (x + xi)*(y + yi) := by
  unfold sqD4
  linear_combination (0) * hx + (0) * hy + (0) * h2

/-- N4 + D4 + self is rule 150 along each axis: (1 + x + 1/x)(1 + y + 1/y). -/
theorem square_N4D4self_tensor (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqN4D4self x xi y yi) =
      (1 + x + xi)*(1 + y + yi) := by
  unfold sqN4D4self
  linear_combination (0) * hx + (0) * hy + (0) * h2

/-- D4 + A4 + self is rule 150 along each diagonal: (1 + xy + 1/(xy))(1 + x/y + y/x). -/
theorem square_D4A4self_diagonals (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqD4A4self x xi y yi) =
      (1 + x*y + xi*yi)*(1 + x*yi + xi*y) := by
  unfold sqD4A4self
  linear_combination (-y^2 - yi^2) * hx + (-x^2 - xi^2) * hy + (0) * h2

/-- The knight shell is N4 D4. -/
theorem square_K8_product (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqK8 x xi y yi) =
      (sqD4 x xi y yi)*(sqN4 x xi y yi) := by
  unfold sqD4 sqK8 sqN4
  linear_combination (-2*y - 2*yi) * hx + (-2*x - 2*xi) * hy + (-x - xi - y - yi) * h2

/-- N4 + K8 + C4 = N4^3: a perfect cube (round 2). -/
theorem square_N4K8C4_cube (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqN4K8C4 x xi y yi) =
      (sqN4 x xi y yi)^3 := by
  unfold sqN4 sqN4K8C4
  linear_combination (-6*y - 6*yi - 3*x - 3*xi) * hx + (-6*x - 6*xi - 3*y - 3*yi) * hy + (-4*x - 4*xi - 4*y - 4*yi - x*y^2 - x*yi^2 - xi*y^2 - xi*yi^2 - y*x^2 - y*xi^2 - yi*x^2 - yi*xi^2) * h2

/-- A4 + K8 + C4 + self = (1 + N4)^3: a perfect cube (round 2). -/
theorem square_A4K8C4self_cube (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqA4K8C4self x xi y yi) =
      (1 + (sqN4 x xi y yi))^3 := by
  unfold sqA4K8C4self sqN4
  linear_combination (-6 - 6*y - 6*yi - 3*x - 3*xi) * hx + (-6 - 6*x - 6*xi - 3*y - 3*yi) * hy + (-6 - x^2 - xi^2 - y^2 - yi^2 - 6*x - 6*xi - 6*y - 6*yi - x*y^2 - x*yi^2 - xi*y^2 - xi*yi^2 - y*x^2 - y*xi^2 - yi*x^2 - yi*xi^2 - 3*x*y - 3*x*yi - 3*xi*y - 3*xi*yi) * h2

/-- C4 + self = (1 + N4)(x^3, y^3): a dilation by 3 (round 2). -/
theorem square_C4self_dilation (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqC4self x xi y yi) =
      1 + (sqN4 (x^3) (xi^3) (y^3) (yi^3)) := by
  unfold sqC4self sqN4
  linear_combination (0) * hx + (0) * hy + (0) * h2

/-- A4 + C4 = q(x + 1/x) + q(y + 1/y), with q(t) = t^3 + t^2 + t (round 2's accident at 13). -/
theorem square_A4C4_separable (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (sqA4C4 x xi y yi) =
      x + xi + y + yi + (x + xi)^2 + (x + xi)^3 + (y + yi)^2 + (y + yi)^3 := by
  unfold sqA4C4
  linear_combination (-2 - 3*x - 3*xi) * hx + (-2 - 3*y - 3*yi) * hy + (-2 - 2*x - 2*xi - 2*y - 2*yi) * h2

/-- The triangle's edge rule squares to (1 + VS) I: ud du = 1 + VS. -/
theorem triangle_E_square (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (triDuE x xi y yi)*(triUdE x xi y yi) =
      1 + (triVS x xi y yi) := by
  unfold triDuE triUdE triVS
  linear_combination (y*yi) * hx + (2 + x + xi) * hy + (1) * h2

/-- The edge rule's matrix [[0, ud], [du, 0]] squares to s I with s = ud du. -/
theorem triangle_E_s (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (triDuE x xi y yi)*(triUdE x xi y yi) =
      (triSE x xi y yi) := by
  unfold triDuE triSE triUdE
  linear_combination (y*yi) * hx + (2 + x + xi) * hy + (1) * h2

/-- VO + T13's matrix [[0, ud], [du, 0]] squares to s I with s = ud du. -/
theorem triangle_VOT13_s (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (triDuVOT13 x xi y yi)*(triUdVOT13 x xi y yi) =
      (triSVOT13 x xi y yi) := by
  unfold triDuVOT13 triSVOT13 triUdVOT13
  linear_combination (4 + y^2 + y^4 + yi^2 + yi^4 + 2*x + 2*xi + 2*y + 2*yi + 3*y^3 + 3*yi^3 + x*y^3 + x*y^4 + x*yi^2 + x*yi^3 + xi*y^2 + xi*y^3 + xi*yi^3 + xi*yi^4 + y^2*yi^2 + y^2*yi^3 + y^3*yi^2 + 2*x*xi + 2*x*y + 2*xi*yi + 2*y*yi + 2*y^3*yi^3 + x*xi*y + x*xi*yi + x*xi*y^3 + x*xi*yi^3 + x*y^3*yi^2 + x*y^3*yi^3 + xi*y^2*yi^3 + xi*y^3*yi^3 + x*xi*y*yi + x*xi*y^3*yi^3) * hx + (5 + x + xi + y + yi + x^3 + xi^3 + x*y + xi*yi + y*yi^2 + yi*y^2 + 2*y^2*yi^2 + 3*y*yi + x*y*yi + x*yi*y^2 + x*y^2*yi^2 + xi*y*yi + xi*y*yi^2 + xi*y^2*yi^2) * hy + (4 + x + xi + y + yi + x^3 + xi^3 + y^3 + yi^3 + x*y + xi*yi + x^3*y^3 + xi^3*yi^3) * h2

/-- VO + T13 squares to s I with s = s_E(x, y) s_E(x^3, y^3), s_E = ud_E du_E: the twisted power of round 3. -/
theorem triangle_VOT13_twisted (h2 : (2 : R) = 0) (x xi y yi : R) (hx : x * xi = 1) (hy : y * yi = 1) :
    (triDuVOT13 x xi y yi)*(triUdVOT13 x xi y yi) =
      (triDuE (x^3) (xi^3) (y^3) (yi^3))*(triDuE x xi y yi)*(triUdE (x^3) (xi^3) (y^3) (yi^3))*(triUdE x xi y yi) := by
  unfold triDuE triDuVOT13 triUdE triUdVOT13
  linear_combination (4 + y^2 + y^4 + yi^2 + yi^4 + 2*x + 2*xi + 2*y + 2*yi + 3*y^3 + 3*yi^3 + x*y^3 + x*y^4 + x*yi^2 + x*yi^3 + xi*y^2 + xi*y^3 + xi*yi^3 + xi*yi^4 + y*yi + y^2*yi^2 + y^2*yi^3 + y^3*yi^2 + y^3*yi^3 - y*yi^4 - yi*y^4 - y^3*yi^4 - y^4*yi^3 - 3*y^4*yi^4 + 2*x*xi + 2*x*y + 2*xi*yi + x*xi*y + x*xi*yi + x*xi*y^3 + x*xi*yi^3 + x*y^3*yi^2 + x*y^3*yi^3 + xi*y^2*yi^3 + xi*y^3*yi^3 - x*y^4*yi^3 - x*y^4*yi^4 - xi*y^3*yi^4 - xi*y^4*yi^4 - y*xi^2*yi^3 - y*xi^2*yi^4 - y*xi^3*yi^4 - yi*x^2*y^3 - yi*x^2*y^4 - yi*x^3*y^4 - x^2*y^3*yi^4 - x^2*y^4*yi^4 - x^3*y^4*yi^4 - xi^2*y^4*yi^3 - xi^2*y^4*yi^4 - xi^3*y^4*yi^4 + x*xi*y*yi - x*xi*y^3*yi^4 - x*xi*y^4*yi^3 - x*xi^2*y^3*yi^4 - x*xi^2*y^4*yi^4 - xi*x^2*y^4*yi^3 - xi*x^2*y^4*yi^4 - x^2*xi^2*y^3*yi^3 - x^2*xi^2*y^3*yi^4 - x^2*xi^2*y^4*yi^3 - x^2*xi^3*y^3*yi^4 - x^2*xi^3*y^4*yi^4 - x^3*xi^2*y^4*yi^3 - x^3*xi^2*y^4*yi^4 - x^3*xi^3*y^4*yi^4 - 2*x*xi*y^4*yi^4 - 2*x^2*xi^2*y^4*yi^4) * hx + (-3 - y - yi - x^2 - x^4 - xi^2 - xi^4 - y^2 - yi^2 - 2*x - 2*xi - 2*x^3 - 2*xi^3 - 2*y^3 - 2*yi^3 - x*y - x*y^3 - x*yi^2 - x*yi^3 - xi*yi - xi*y^2 - xi*y^3 - xi*yi^3 - y*x^3 - y*x^4 - y*xi^2 - y*xi^3 - y*yi^2 - yi*x^2 - yi*x^3 - yi*xi^3 - yi*xi^4 - yi*y^2 - x^2*y^2 - x^2*y^3 - x^3*y^2 - x^4*y^3 - xi^2*yi^2 - xi^2*yi^3 - xi^3*yi^2 - xi^4*yi^3 - 4*y^2*yi^2 - 4*y^3*yi^3 - 3*y*yi - 2*x^3*y^3 - 2*xi^3*yi^3 - 2*y^2*yi^3 - 2*y^3*yi^2 - x*y*yi - x*yi*y^2 - x*y^2*yi^2 - xi*y*yi - xi*y*yi^2 - xi*y^2*yi^2 - y*yi*x^2 - y*yi*x^4 - y*yi*xi^2 - y*yi*xi^4 - y*x^2*yi^2 - y*x^3*yi^2 - y*xi^3*yi^2 - y*xi^4*yi^2 - yi*x^3*y^2 - yi*x^4*y^2 - yi*xi^2*y^2 - yi*xi^3*y^2 - x^2*y^2*yi^2 - x^2*y^2*yi^3 - x^2*y^3*yi^3 - x^3*y^2*yi^3 - x^3*y^3*yi^2 - x^4*y^2*yi^2 - x^4*y^3*yi^2 - x^4*y^3*yi^3 - xi^2*y^2*yi^2 - xi^2*y^3*yi^2 - xi^2*y^3*yi^3 - xi^3*y^2*yi^3 - xi^3*y^3*yi^2 - xi^4*y^2*yi^2 - xi^4*y^2*yi^3 - xi^4*y^3*yi^3 - 3*y*yi*x^3 - 3*y*yi*xi^3 - 3*x^3*y^2*yi^2 - 3*xi^3*y^2*yi^2 - 2*x*y^3*yi^2 - 2*x*y^3*yi^3 - 2*xi*y^2*yi^3 - 2*xi*y^3*yi^3 - 2*x^3*y^3*yi^3 - 2*xi^3*y^3*yi^3) * hy + (0) * h2

