/-! ### The unit (a + 1)(b + 1) at 61, where 3 = 2^6: (t + 1)^2 = t^63 -/

theorem pow_mod61 {X : K} (hX : X ^ 61 = 1) (n : ℕ) : X ^ n = X ^ (n % 61) := by
  conv_lhs => rw [← Nat.div_add_mod n 61, pow_add, pow_mul, hX, one_pow, one_mul]

theorem inv_eq_pow60 {X : K} (hX : X ^ 61 = 1) : X⁻¹ = X ^ 60 :=
  inv_eq_of_mul_eq_one_right (by rw [← pow_succ', hX])

theorem t_frob61 {z : K} (hz : z ^ 61 = 1) : (z + z⁻¹) ^ 2 ^ 30 = z + z⁻¹ := by
  rw [inv_eq_pow60 hz, add_pow_char_pow, ← pow_mul, pow_mod61 hz (2 ^ 30),
    pow_mod61 hz (60 * 2 ^ 30), show 2 ^ 30 % 61 = 60 by norm_num,
    show 60 * 2 ^ 30 % 61 = 1 by norm_num, pow_one, add_comm]

theorem t_pow64 {z : K} (hz : z ^ 61 = 1) : (z + z⁻¹) ^ 64 = z ^ 3 + z⁻¹ ^ 3 := by
  have h := add_pow_char_pow (R := K) (p := 2) z z⁻¹ (n := 6)
  have h64 : z ^ 64 = z ^ 3 := by simpa using pow_mod61 hz 64
  norm_num at h
  rw [h, h64, inv_pow]

theorem psi3_val61 {x : K} (hx : x ^ 61 = 1) :
    x + x⁻¹ + 1 = 0 ∨ (x + x⁻¹ + 1) ^ 357913941 = 1 := by
  have h2 : (2 : K) = 0 := two_eq_zero_of_charTwo
  obtain ⟨hX2, hz⟩ := sq_root (h := 31) (by norm_num) hx
  rw [← hX2, psi3_sq]
  set z := x ^ 31
  have hz0 : z ≠ 0 := ne_zero_of_pow_eq_one (m := 61) hz
  right
  by_cases ht : z + z⁻¹ = 0
  · rw [ht]
    simp
  · have hid := Cubes37.line_identity h2 z z⁻¹ (mul_inv_cancel₀ hz0)
    rw [← t_pow64 hz] at hid
    have hv : (z + z⁻¹ + 1) ^ 2 = (z + z⁻¹) ^ 63 :=
      mul_right_cancel₀ ht (by rw [hid]; ring)
    have hT := (eq_zero_or_pow_eq_one (pow_pos two_pos 30).ne' (t_frob61 hz)).resolve_left ht
    rw [hv, ← pow_mul, show 63 * 357913941 = (2 ^ 30 - 1) * 21 by norm_num, pow_mul, hT, one_pow]

theorem psi3psi3_val61 {x y : K} (hx : x ^ 61 = 1) (hy : y ^ 61 = 1) :
    (x + x⁻¹ + 1) * (y + y⁻¹ + 1) = 0 ∨ ((x + x⁻¹ + 1) * (y + y⁻¹ + 1)) ^ 357913941 = 1 :=
  Cubes37.prod_val (psi3_val61 hx) (psi3_val61 hy)

