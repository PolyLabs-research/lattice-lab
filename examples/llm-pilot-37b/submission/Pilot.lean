section Field

variable {K : Type*} [Field K] [CharP K 2]

/-- From values to the period: if every value of D at m-th roots of unity is 0 or has order
dividing N, the period of D on the m-torus divides N. -/
theorem period_dvd_of_ev {m : ℕ} [NeZero m] (hm : Odd m) (D : Finset (ℤ × ℤ)) (N : ℕ)
    (h : ∀ x y : AlgebraicClosure (ZMod 2), x ^ m = 1 → y ^ m = 1 →
      ev D x y = 0 ∨ ev D x y ^ N = 1) :
    period m D ∣ N := by
  obtain ⟨ζ, hζ⟩ := exists_primitiveRoot hm
  rw [← isPeriod_iff_period_dvd, isPeriod_iff hζ]
  intro j _ k _
  rw [lam_eq_ev hζ.pow_eq_one]
  have hp : ∀ i : ℕ, ((ζ ^ i)⁻¹) ^ m = 1 := fun i => by
    rw [inv_pow, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow, inv_one]
  exact h _ _ (hp j) (hp k)

/-- A value fixed by the 2^s-th power is 0 or its cube has order dividing (2^s - 1)/3. -/
theorem cube_val {g : K} {s N : ℕ} (hs : 2 ^ s - 1 = 3 * N) (hg : g ^ 2 ^ s = g) :
    g ^ 3 = 0 ∨ (g ^ 3) ^ N = 1 := by
  rcases eq_zero_or_pow_eq_one (pow_pos two_pos s).ne' hg with h | h
  · left; rw [h]; ring
  · right; rw [← pow_mul, ← hs]; exact h

theorem frob_n {a b : K} {s : ℕ} (ha : a ^ 2 ^ s = a) (hb : b ^ 2 ^ s = b) :
    (a + b + 1) ^ 2 ^ s = a + b + 1 := by
  simp only [add_pow_char_pow, ha, hb, one_pow]

theorem frob_d {a b : K} {s : ℕ} (ha : a ^ 2 ^ s = a) (hb : b ^ 2 ^ s = b) :
    (a * b + 1) ^ 2 ^ s = a * b + 1 := by
  simp only [add_pow_char_pow, mul_pow, ha, hb, one_pow]

theorem frob_m {a b : K} {s : ℕ} (ha : a ^ 2 ^ s = a) (hb : b ^ 2 ^ s = b) :
    (a * b + a + b) ^ 2 ^ s = a * b + a + b := by
  simp only [add_pow_char_pow, mul_pow, ha, hb]

/-- x = (x^h)^2 for x^m = 1, m = 2h - 1. -/
theorem sq_root {m h : ℕ} (hmh : 2 * h = m + 1) {x : K} (hx : x ^ m = 1) :
    (x ^ h) ^ 2 = x ∧ (x ^ h) ^ m = 1 := by
  refine ⟨?_, ?_⟩
  · rw [← pow_mul, mul_comm, hmh, pow_succ, hx, one_mul]
  · rw [← pow_mul, mul_comm, pow_mul, hx, one_pow]

/-- a + 1 = (t + 1)^2 with t = z + 1/z, x = z^2 (characteristic 2). -/
theorem psi3_sq {z : K} : z ^ 2 + (z ^ 2)⁻¹ + 1 = (z + z⁻¹ + 1) ^ 2 := by
  have h2 : (2 : K) = 0 := two_eq_zero_of_charTwo
  linear_combination (-(z * z⁻¹) - z - z⁻¹) * h2

/-- a + b = t(XY) t(X/Y) for x = X^2, y = Y^2. -/
theorem sum_split {X Y : K} (hX : X ≠ 0) (hY : Y ≠ 0) :
    X ^ 2 + (X ^ 2)⁻¹ + (Y ^ 2 + (Y ^ 2)⁻¹) =
      (X * Y + (X * Y)⁻¹) * (X * Y⁻¹ + (X * Y⁻¹)⁻¹) := by
  field_simp
  ring

/-! ### The units at 37 (rule 90 is confined to the cubes there) -/

theorem sum_val37 {x y : K} (hx : x ^ 37 = 1) (hy : y ^ 37 = 1) :
    x + x⁻¹ + (y + y⁻¹) = 0 ∨ (x + x⁻¹ + (y + y⁻¹)) ^ 87381 = 1 := by
  obtain ⟨hX2, hX⟩ := sq_root (h := 19) (by norm_num) hx
  obtain ⟨hY2, hY⟩ := sq_root (h := 19) (by norm_num) hy
  have hX0 : x ^ 19 ≠ 0 := ne_zero_of_pow_eq_one (m := 37) hX
  have hY0 : y ^ 19 ≠ 0 := ne_zero_of_pow_eq_one (m := 37) hY
  have hXY : (x ^ 19 * y ^ 19) ^ 37 = 1 := by rw [mul_pow, hX, hY, one_mul]
  have hXYi : (x ^ 19 * (y ^ 19)⁻¹) ^ 37 = 1 := by rw [mul_pow, inv_pow, hX, hY, inv_one, one_mul]
  rw [← hX2, ← hY2, sum_split hX0 hY0]
  exact Cubes37.prod_val (Cubes37.r90_val hXY) (Cubes37.r90_val hXYi)

theorem prod_val37 {x y : K} (hx : x ^ 37 = 1) (hy : y ^ 37 = 1) :
    (x + x⁻¹) * (y + y⁻¹) = 0 ∨ ((x + x⁻¹) * (y + y⁻¹)) ^ 87381 = 1 :=
  Cubes37.prod_val (Cubes37.r90_val hx) (Cubes37.r90_val hy)

theorem psi3_val37 {x : K} (hx : x ^ 37 = 1) :
    x + x⁻¹ + 1 = 0 ∨ (x + x⁻¹ + 1) ^ 87381 = 1 := by
  obtain ⟨hX2, hX⟩ := sq_root (h := 19) (by norm_num) hx
  rw [← hX2, psi3_sq]
  exact Cubes37.line_val (fun z hz => Cubes37.r90_val hz) hX

