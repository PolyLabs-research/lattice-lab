  · left
    rw [hB] at hid
    exact (mul_eq_zero.1 hid).resolve_right hN0
  · right
    have := congrArg (· ^ 341) hid
    simp only [mul_pow] at this
    rw [hN, mul_one, hB] at this
    exact this

