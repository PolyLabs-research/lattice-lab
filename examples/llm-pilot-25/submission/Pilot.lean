theorem zpow_pow_comm (x : K) (a : ℤ) (k : ℕ) : (x ^ a) ^ k = (x ^ k) ^ a := by
  rw [← zpow_natCast, ← zpow_natCast x, ← zpow_mul, ← zpow_mul, mul_comm]

theorem ev_frob (D : Finset (ℤ × ℤ)) (x y : K) (n : ℕ) :
    ev D x y ^ 2 ^ n = ev D (x ^ 2 ^ n) (y ^ 2 ^ n) := by
  unfold ev
  rw [sum_pow_char_pow]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [mul_pow, zpow_pow_comm, zpow_pow_comm]

/-- **Twisted pairs at 25.** If D = C(x, y) C(x^3, y^3) with C symmetric, every eigenvalue of D
at 25 is 0 or has order dividing 341: it is c^129 with c = C(x, y), c^1023 = 1. -/
theorem twisted_val (C D : Finset (ℤ × ℤ))
    (hC : ∀ x y : K, x ≠ 0 → y ≠ 0 → ev C x⁻¹ y⁻¹ = ev C x y)
    (hD : ∀ x y : K, x ≠ 0 → y ≠ 0 → ev D x y = ev C x y * ev C (x ^ 3) (y ^ 3))
    {X Y : K} (hX : X ^ 25 = 1) (hY : Y ^ 25 = 1) :
    ev D X Y = 0 ∨ ev D X Y ^ 341 = 1 := by
  have hX0 : X ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hX
  have hY0 : Y ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hY
  have h3 : ev C (X ^ 3) (Y ^ 3) = ev C X Y ^ 128 := by
    rw [show (128 : ℕ) = 2 ^ 7 by norm_num, ev_frob, pow_mod25 hX (2 ^ 7), pow_mod25 hY (2 ^ 7),
      show 2 ^ 7 % 25 = 3 by norm_num]
  have h10 : ev C X Y ^ 2 ^ 10 = ev C X Y := by
    rw [ev_frob, pow_mod25 hX, pow_mod25 hY, show 2 ^ 10 % 25 = 24 by norm_num,
      ← inv_eq_pow24 hX, ← inv_eq_pow24 hY, hC X Y hX0 hY0]
  rw [hD X Y hX0 hY0, h3]
  by_cases hc : ev C X Y = 0
  · left; rw [hc]; norm_num
  · right
    have h1023 : ev C X Y ^ 1023 = 1 := by
      have : ev C X Y * ev C X Y ^ 1023 = ev C X Y * 1 := by
        rw [mul_one, ← pow_succ']; exact h10
      exact mul_left_cancel₀ hc this
    rw [← pow_succ', ← pow_mul, show (128 + 1) * 341 = 1023 * 43 by norm_num, pow_mul, h1023,
      one_pow]

