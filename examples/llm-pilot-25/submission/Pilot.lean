theorem r3096_val {X Y : K} (hX : X ^ 25 = 1) (hY : Y ^ 25 = 1) :
    ev r3096Offsets X Y = 0 ∨ ev r3096Offsets X Y ^ 341 = 1 := by
  have h2 : (2 : K) = 0 := two_eq_zero_of_charTwo
  have hX0 : X ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hX
  have hY0 : Y ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hY
  rw [ev_r3096]
  by_cases n1 : X + X⁻¹ = 0
  · rw [eq_one_of_add_inv hX n1, inv_one, r3096_axisx h2 _ _ (mul_inv_cancel₀ hY0)]
    exact axis_val hY
  by_cases n2 : Y + Y⁻¹ = 0
  · rw [eq_one_of_add_inv hY n2, inv_one, r3096_axisy h2 _ _ (mul_inv_cancel₀ hX0)]
    exact axis_val hX
  have v1 := (t_val hX).resolve_left n1
  have v2 := (t_val hY).resolve_left n2
  have hid := r3096_identity h2 X X⁻¹ Y Y⁻¹ (mul_inv_cancel₀ hX0) (mul_inv_cancel₀ hY0)
  rw [r3096B_eq hX hY] at hid
  have hN : ((X + X⁻¹) ^ 3) ^ 341 * ((Y + Y⁻¹) ^ 3) ^ 341 = 1 := by
    rw [← pow_mul, ← pow_mul, show 3 * 341 = 1023 by norm_num, v1, v2, one_mul]
  have hN0 : ((X + X⁻¹) * (Y + Y⁻¹)) ^ 3 ≠ 0 := pow_ne_zero _ (mul_ne_zero n1 n2)
