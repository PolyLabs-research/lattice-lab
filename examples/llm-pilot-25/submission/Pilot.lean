/-- From the eigenvalues to the period: if every value of D at 25th roots of unity is 0 or has
order dividing 341, the period of D on the 25-torus divides 341 = (2^10 - 1)/3. -/
theorem period_dvd_of_val (D : Finset (ℤ × ℤ))
    (hv : ∀ X Y : AlgebraicClosure (ZMod 2), X ^ 25 = 1 → Y ^ 25 = 1 →
      ev D X Y = 0 ∨ ev D X Y ^ 341 = 1) :
    period 25 D ∣ 341 := by
  obtain ⟨ζ, hζ⟩ := exists_primitiveRoot (m := 25) ⟨12, rfl⟩
  rw [← isPeriod_iff_period_dvd, isPeriod_iff hζ]
  intro j _ k _
  rw [lam_eq_ev hζ.pow_eq_one]
  have hp : ∀ i : ℕ, ((ζ ^ i)⁻¹) ^ 25 = 1 := fun i => by
    rw [inv_pow, ← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow, inv_one]
  exact hv _ _ (hp j) (hp k)

/-- **Theorem.** Every nonzero eigenvalue of r3096 at m = 25 is a cube in F(2^10):
its period on the 25 x 25 torus divides 341. -/
theorem period_r3096_dvd : period 25 r3096Offsets ∣ 341 :=
  period_dvd_of_val _ fun _ _ hX hY => r3096_val hX hY

