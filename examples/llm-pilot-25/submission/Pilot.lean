    (X ^ a * Y ^ b) ^ 2 ^ 5 = X ^ a' * Y ^ b' := by
  rw [mul_pow, ← pow_mul, ← pow_mul, pow_mod25 hX, pow_mod25 hY, ha, hb]

theorem inv_eq_pow24 {X : K} (hX : X ^ 25 = 1) : X⁻¹ = X ^ 24 :=
  inv_eq_of_mul_eq_one_right (by rw [← pow_succ', hX])

theorem eq_one_of_add_inv {z : K} (hz : z ^ 25 = 1) (h : z + z⁻¹ = 0) : z = 1 := by
  have hz0 : z ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hz
  have h1 : z = z⁻¹ := by
    have := congrArg (· + z⁻¹) h
    simpa [CharTwo.add_self_eq_zero, add_assoc] using this
  have h2 : z ^ 2 = 1 := by
    rw [sq]
    nth_rewrite 2 [h1]
    exact mul_inv_cancel₀ hz0
  calc z = z * (z ^ 2) ^ 12 := by rw [h2, one_pow, mul_one]
    _ = z ^ 25 := by ring
    _ = 1 := hz

/-- Frobenius on a rule-90 value: (z + 1/z)^(2^n) = z^(2^n) + 1/z^(2^n). -/
theorem t_frob (z : K) (n : ℕ) : (z + z⁻¹) ^ 2 ^ n = z ^ 2 ^ n + (z ^ 2 ^ n)⁻¹ := by
  rw [add_pow_char_pow, inv_pow]

/-- Rule-90 values at 25 lie in F(2^10): t = 0 or t^1023 = 1. -/
theorem t_val {z : K} (hz : z ^ 25 = 1) : z + z⁻¹ = 0 ∨ (z + z⁻¹) ^ 1023 = 1 := by
  have h : (z + z⁻¹) ^ 2 ^ 10 = z + z⁻¹ := by
    rw [t_frob, pow_mod25 hz, show 2 ^ 10 % 25 = 24 by norm_num, ← inv_eq_pow24 hz, inv_inv,
      add_comm]
  by_cases h0 : z + z⁻¹ = 0
  · exact Or.inl h0
  · right
    have : (z + z⁻¹) * (z + z⁻¹) ^ 1023 = (z + z⁻¹) * 1 := by
      rw [mul_one, ← pow_succ']; exact h
    exact mul_left_cancel₀ h0 this

/-- t(z^3) = t(z)^128 at 25 (3 = 2^7 mod 25). -/
theorem t_cube {z : K} (hz : z ^ 25 = 1) : z ^ 3 + (z ^ 3)⁻¹ = (z + z⁻¹) ^ 128 := by
  rw [show (128 : ℕ) = 2 ^ 7 by norm_num, t_frob, pow_mod25 hz (2 ^ 7),
    show 2 ^ 7 % 25 = 3 by norm_num]

/-- (t + 1)^2 t = t(x^3) for t = x + 1/x, in characteristic 2 (as in Cubes37). -/
theorem line_identity {R : Type*} [CommRing R] (h2 : (2 : R) = 0) (x xi : R) (hx : x * xi = 1) :
    (x + xi + 1)^2 * (x + xi) = x^3 + xi^3 := by
  linear_combination (x^2 + 2*x + xi^2 + 2*xi + 2) * h2 + (3*x + 3*xi + 4) * hx

/-- On the axes: t^2 (t + 1)^2 = t(z) t(z^3) = t^129, so its 341st power is 1 (or it is 0). -/
theorem axis_val {z : K} (hz : z ^ 25 = 1) :
    ((z + z⁻¹) * (z + z⁻¹ + 1)) ^ 2 = 0 ∨ (((z + z⁻¹) * (z + z⁻¹ + 1)) ^ 2) ^ 341 = 1 := by
  have h2 : (2 : K) = 0 := two_eq_zero_of_charTwo
  have hz0 : z ≠ 0 := ne_zero_of_pow_eq_one (m := 25) hz
  have hid := line_identity h2 z z⁻¹ (mul_inv_cancel₀ hz0)
  rw [inv_pow, t_cube hz] at hid
  have e : ((z + z⁻¹) * (z + z⁻¹ + 1)) ^ 2 = (z + z⁻¹) ^ 129 := by
    rw [show (129 : ℕ) = 1 + 128 by norm_num, pow_add, pow_one, ← hid]; ring
  rw [e]
  rcases t_val hz with h | h
  · left; rw [h]; norm_num
  · right; rw [← pow_mul, show 129 * 341 = 1023 * 43 by norm_num, pow_mul, h, one_pow]

/-- The values of a symmetric B fixed by the 2^5-th power: B = 0 or B^341 = 1. -/
theorem frob_val {b : K} (h : b ^ 2 ^ 5 = b) : b = 0 ∨ b ^ 341 = 1 := by
  rcases eq_zero_or_pow_eq_one (by norm_num) h with h | h
  · exact Or.inl h
  · right; norm_num at h; rw [show 341 = 31 * 11 by norm_num, pow_mul, h, one_pow]

