k(i, j) for i - j odd (sets: should be singletons):
  i=0: ['-', '{2}', '-', '{2}', '-', '{1}']
  i=1: ['{2}', '-', '{0}', '-', '{0}', '-']
  i=2: ['-', '{0}', '-', '{1}', '-', '{1}']
  i=3: ['{2}', '-', '{1}', '-', '{2}', '-']
  i=4: ['-', '{0}', '-', '{2}', '-', '{0}']
  i=5: ['{1}', '-', '{1}', '-', '{0}', '-']
